# =====================================================================
# TEMPLATE kredensial — SALIN ke .handover/credentials.env
# File hasil salinan TIDAK di-commit (lihat .gitignore: /.handover)
#
#   cp .handover/credentials.env.example .handover/credentials.env
#   chmod 600 .handover/credentials.env
#
# Isi nilai sebenarnya dari pengelola (jangan tulis di dokumen/chat).
# =====================================================================

# --- GitHub ---
GITHUB_REPO=https://github.com/syahrulmail/berbagi
GITHUB_DEFAULT_BRANCH=master
# Autentikasi push memakai credential helper terpasang (lihat docs/HANDOVER.md).

# --- FTP produksi (cPanel) ---
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_PROTOCOL=ftp
FTP_ROOT=/
FTP_APP_PATH=/
FTP_PUBLIC_PATH=/public

# --- Database produksi (MySQL/MariaDB cPanel) ---
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Aplikasi ---
APP_URL=https://berbagi.or.id
APP_ENV=production
PHP_VERSION_PROD=
