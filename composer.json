{
    "name": "berbagi/berbagi",
    "description": "Berbagi.or.id - Platform berbagi konten berbasis PHP dan MySQL",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
